# ─────────────────────────────────────────────────────────────
# LokSrijan — root environment template
#
# This file documents every environment variable used anywhere in the
# monorepo. It is the reference; each application also ships its own
# template that you actually copy:
#
#   backend/.env.example   ->  backend/.env
#   frontend/.env.example  ->  frontend/.env.local
#
# The root .env is only read by docker-compose.
#   cp .env.example .env
#
# NEVER commit real credentials. `.env` files are git-ignored.
# ─────────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════════
# DATABASE — required now
# ═════════════════════════════════════════════════════════════

# Consumed by docker-compose.yml when creating the local Postgres
# container. Development-only values; not secrets.
POSTGRES_USER=loksrijan
POSTGRES_PASSWORD=loksrijan
POSTGRES_DB=loksrijan
POSTGRES_PORT=5432

# Consumed by the backend (see backend/.env.example).
DATABASE_URL=postgresql+psycopg://loksrijan:loksrijan@localhost:5432/loksrijan


# ═════════════════════════════════════════════════════════════
# BACKEND — required now
# ═════════════════════════════════════════════════════════════

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_NAME=loksrijan-api
ENVIRONMENT=development
DEBUG=true


# ═════════════════════════════════════════════════════════════
# FRONTEND — required now
# ═════════════════════════════════════════════════════════════

# Base URL of the backend API. NEXT_PUBLIC_ variables are exposed to the
# browser, so never put a secret in one.
NEXT_PUBLIC_API_URL=http://localhost:8000


# ═════════════════════════════════════════════════════════════
# AI LAYER — RESERVED, not used yet
# ═════════════════════════════════════════════════════════════
# The AI layer is not implemented. These names are reserved so nothing
# needs renaming later. LokSrijan is provider-agnostic by design: the
# provider is selected via configuration, never hardcoded.

# Provider name. Use "mock" for local development — it needs no key.
AI_PROVIDER=
AI_API_KEY=


# ═════════════════════════════════════════════════════════════
# RESERVED FOR LATER PHASES — intentionally unset
# ═════════════════════════════════════════════════════════════
# Not installed and not configured yet. Listed only so the team knows
# these decisions are pending rather than forgotten.
#
# REDIS_URL=            background jobs / caching
# ENABLE_POSTGIS=       geospatial queries
# ENABLE_PGVECTOR=      semantic similarity search
# JWT_SECRET=           authentication (deferred)
