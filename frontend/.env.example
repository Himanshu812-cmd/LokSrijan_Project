# ─────────────────────────────────────────────────────────────
# LokSrijan frontend — environment template
#
# Copy this file to `frontend/.env.local` and adjust if needed.
#   cp .env.example .env.local
#
# `.env.local` is git-ignored.
#
# WARNING: every NEXT_PUBLIC_* variable is inlined into the JavaScript
# bundle and is therefore visible to anyone using the site. Never put an
# API key, password, or secret in a NEXT_PUBLIC_* variable.
# ─────────────────────────────────────────────────────────────

# ── REQUIRED NOW ─────────────────────────────────────────────

# Base URL of the LokSrijan backend API.
NEXT_PUBLIC_API_URL=http://localhost:8000
